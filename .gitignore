# ═══ محجوبٌ عن النشرِ — امرُ فاضل 29 ايلول 2026 ═══
# «يبقى المفسّرُ مخفيّا ومحميّا كى لا تُسرَقَ اللغة»
_محجوب_عن_النشر/
downloads/السادس/

# ═══ الثقيلُ يُرفَعُ فى GitHub Release ⛔ ولا يدخلُ التاريخَ — 29 ايلول 2026 ═══
# العلّةُ مقيسة : كلُّ نشرةٍ للبيئةِ تُضيفُ 5.5 م.ب الى .git للابد ، وbase64 لا يُضغَطُ تفاضليّا
# ⟹ و«version.json» يشيرُ الى رابطِ الاصدارِ ⟹ فالتحديثُ الآلىُّ يعملُ كما هو
_حرز_البيئة/
_حرز_20260822_1617/
_ملغى_المترجم_الخامس_2026_08_21/
_متقاعد_29_ايلول/

# حال بناء محلي ⛔ لا يُنشَر
_سند_البناء.json
_ترقيع_عاجل.txt

# ═══ ادواتُ مِحرزِ الجُمَّل ⛔ لا تُودَعُ ابدا — امرُ فاضل 9 تشرين الاوّل 2026 ═══
# «نشفّر المفسّر والمترجم بتشفيرنا كما فى لغة فاضل جزء التشفير»
# والعلّةُ : المستودعُ علنىٌّ. والفاكُّ مزروعٌ فى البيئةِ بالضرورةِ (تعملُ بلا
# انترنت) ⟹ فحسابُه مرئىٌّ هناك ارقاما مجرّدةً بلا شرحٍ. اما هذه الادواتُ
# فتحملُ المفتاحَ حروفا والشرحَ كاملا ⟹ فايداعُها يُبطِلُ الحرزَ من اصلِه.
_محرز_الجمل.py
_حرز_الكتل.py
_فك_الجمل.js
_قس_اثر_الحرز.py
_خطة_محو_المصدر.md
_يُمحى_من_التاريخ.txt

# ═══ ادواتُ العملِ ⛔ لا تُتتبَّعُ — امرُ فاضل 9 تشرين الاوّل 2026 ═══
# 🔴 العلّةُ المقيسةُ : «_config.yml» يمنعُ Jekyll من نشرِها، ⛔ ولا يمنعُ
#    احدا من قراءتِها على GitHub — والمستودعُ علنىٌّ (جوابُ 200 بلا اعتمادٍ).
#    وفيها مقيسا : مسارُ القرصِ · اسمُ مجلّدِ اللغةِ · اسمُ مصدرِ المترجمِ ·
#    بصماتُه · اسمُ صورةِ الحديدِ · بنيةُ المجلّداتِ · وانّ الاسماءَ مُختلَقةٌ
#    والرواتبَ مُعدَّلةٌ. ⟹ فهى خريطةُ كلِّ ما نُخفيه.
ابن_البيئة_للنشر.py
اسماء_بديلة.py
افحص_اصدار_البيئة.py
افحص_مصادر_الصفحة.py
حارس_النشر.py
عدل_الحاكم_بامان.py
